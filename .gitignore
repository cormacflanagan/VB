# the full-index crawl, while it is running: these files are appended to for hours and
# committing snapshots of them would put hundreds of megabytes of intermediate state in
# the history. Removed from here and committed once, compressed, when the crawl completes.

# merged corpus: regenerated by scripts/merge.py from the three sources
data/all_matches.jsonl.gz
data/all_finishes.jsonl.gz

# the fitted ratings: 279k lines rewritten wholesale by every run of rate.py, and
# reproducible from the committed corpus in about a minute
data/rating.json

# bootstrap intermediates: a float per player per run, regenerated by scripts/shrink.py
# and scripts/uncertainty.py from the committed corpus in about twelve minutes each
data/se_train.npz
data/rating_se.json
data/boot.npz
